<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FlashMark.Controls"
        x:Class="FlashMark.Views.OverlayWindow"
        Title="FlashMark"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False">
    <Panel x:Name="RootPanel" Background="#01000000">
        <controls:DrawCanvas x:Name="Canvas" />
        <controls:BorderGlow x:Name="BorderGlow" />
        <controls:StatusBar x:Name="StatusBar" />
    </Panel>
</Window>
